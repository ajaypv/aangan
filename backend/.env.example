# Copy to .env and fill in. Nothing is mocked: a feature whose keys are missing reports "not configured"
# in the app's Settings screen (GET /api/config) instead of faking a result.

# --- Voice: Agora Conversational AI (App Credentials mode, per Agora's docs)
# Agora Console project with Conversational AI enabled
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Voice: Murf Falcon TTS. The voice per family member comes from backend/app/voices.py
# (Murf's recommended Indian voices); override the model only if Murf tells you to.
MURF_API_KEY=
MURF_MODEL=FALCON

# --- Voice: Agora calls {PUBLIC_BASE_URL}/v1/chat/completions as the agent's LLM, so this backend must be
# reachable over public HTTPS (ngrok / cloudflared tunnel to port 8000, or a deployment).
PUBLIC_BASE_URL=
# Bearer secret Agora sends to that endpoint. Any long random string.
LLM_API_KEY=

# --- Language mode. multi (default): English, Hindi, Telugu and Kannada. Speech recognition (Deepgram nova-3 `multi`)
# listens for all four, each message is read for its script, the model answers in that language and one multi-native
# Murf voice (hi-IN-rachna / hi-IN-pranav) speaks it. Settings can switch a household to english. english: English only.
# native: each member's own language (Hindi, Hinglish or English), as before.
AANGAN_LANGUAGE_MODE=multi
# The model for Hindi, Telugu and Kannada turns (it writes those far better than the cheap English model).
AI_GATEWAY_MODEL_INDIC=google/gemini-2.5-flash

# --- Agent brain: with an LLM key set, the orchestrator uses a tool-calling loop (app/llm.py) over every
# agent's tools. Order: AI Gateway, OpenAI (Responses API), Anthropic. Without a key, or if the LLM call fails,
# the built-in rule engine handles the request.
# Vercel AI Gateway (first choice): one key, any "provider/model" from https://ai-gateway.vercel.sh/v1/models.
# Free-tier keys can use cheap models only (openai/gpt-5-nano, openai/gpt-4o-mini, google/gemini-2.5-flash-lite).
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5-nano
# Cloudflare AI Gateway (tried BEFORE the Vercel gateway when both are set; the Vercel models are the backup, used at once when
# Cloudflare is rate limited, out of credits (402) or unreachable). Account id: the long hex string in your dashboard address.
# CLOUDFLARE_MODEL: "openai/gpt-4o-mini" (or any provider/model) needs unified billing credits in the Cloudflare dashboard;
# "workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast" needs none but was slower and less reliable with tools in our tests.
# CLOUDFLARE_MODEL_INDIC is empty on purpose: Hindi, Telugu and Kannada turns go straight to the Vercel gateway's Gemini.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_MODEL=openai/gpt-4o-mini
CLOUDFLARE_MODEL_INDIC=
# Direct OpenAI (used when no gateway key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional reasoning effort for the OpenAI model (low, medium, high). Empty uses the model's default.
OPENAI_REASONING=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Agora Chat (family notifications). Optional: without it notifications stay inside the app.
AGORA_CHAT_HOST=
AGORA_CHAT_APP_ID=
AGORA_CHAT_APP_TOKEN=
AGORA_CHAT_FROM=aangan
AGORA_CHAT_TO=
